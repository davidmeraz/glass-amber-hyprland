/* ═══════════════════════════════════════════════════════════
 *  MC20 — Amber Glass Theme
 *  Compact, minimal, glassmorphism with golden glow
 *  Matches powermenu.rasi aesthetic
 * ═══════════════════════════════════════════════════════════ */

* {
    bg:             rgba(8, 8, 8, 0.82);
    bg-entry:       rgba(18, 18, 18, 0.95);
    border-amber:   rgba(201, 168, 76, 0.55);
    glow-amber:     rgba(201, 168, 76, 0.25);
    gold:           #C9A84C;
    gold-dim:       rgba(201, 168, 76, 0.6);
    fg:             #EAEAEA;
    fg-dim:         #777777;
    transparent:    transparent;

    font: "JetBrains Mono Nerd Font 12";
    background-color: transparent;
    text-color: @fg;
}

/* ── Window ─────────────────────────────────────────────── */
window {
    width: 420px;
    background-color: @bg;
    border: 1px solid;
    border-color: @border-amber;
    border-radius: 16px;
    padding: 0;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview, mode-switcher ];
    background-color: transparent;
    padding: 14px;
    spacing: 10px;
}

/* ── Search Bar ─────────────────────────────────────────── */
inputbar {
    children: [ prompt, entry ];
    background-color: @bg-entry;
    border: 1px solid;
    border-color: rgba(201, 168, 76, 0.3);
    border-radius: 12px;
    padding: 10px 14px;
    spacing: 10px;
}

prompt {
    background-color: transparent;
    text-color: @gold;
    padding: 0px;
    font: "JetBrains Mono Nerd Font Bold 12";
    vertical-align: 0.5;
}

entry {
    padding: 0px;
    text-color: @fg;
    background-color: transparent;
    vertical-align: 0.5;
    placeholder: "Buscar...";
    placeholder-color: @fg-dim;
    cursor-color: @gold;
}

/* ── Results List ───────────────────────────────────────── */
listview {
    lines: 7;
    columns: 1;
    padding: 0px;
    spacing: 4px;
    background-color: transparent;
    border: 0px;
    fixed-height: true;
    scrollbar: false;
}

/* ── Items ──────────────────────────────────────────────── */
element {
    padding: 8px 12px;
    background-color: transparent;
    text-color: @fg;
    border-radius: 10px;
    cursor: pointer;
    spacing: 12px;
}

element-icon {
    size: 22px;
    background-color: transparent;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    highlight: bold underline;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal,
element selected.alternate {
    background-color: @glow-amber;
    text-color: @gold;
    border: 1px solid;
    border-color: @border-amber;
}

element normal.active,
element alternate.active {
    text-color: @gold-dim;
}

element selected.active {
    background-color: @glow-amber;
    text-color: @gold;
    border: 1px solid;
    border-color: @border-amber;
}

/* ── Mode Switcher ──────────────────────────────────────── */
mode-switcher {
    spacing: 8px;
}

button {
    padding: 8px;
    background-color: transparent;
    text-color: @fg-dim;
    border-radius: 10px;
    cursor: pointer;
    font: "JetBrains Mono Nerd Font 10";
}

button selected {
    background-color: @glow-amber;
    text-color: @gold;
    border: 1px solid;
    border-color: @border-amber;
}

/* ── Messages ───────────────────────────────────────────── */
message {
    background-color: @bg-entry;
    border: 1px solid;
    border-color: rgba(201, 168, 76, 0.2);
    border-radius: 10px;
    padding: 8px;
}

textbox {
    padding: 4px;
    text-color: @gold-dim;
    background-color: transparent;
}
