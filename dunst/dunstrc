# ═══════════════════════════════════════════════════════════
#  DUNST — Amber Glass Notifications
#  Compact, minimal, glassmorphism with golden accents
#  Matches rofi powermenu / mc20 aesthetic
# ═══════════════════════════════════════════════════════════

[global]
    # ── Geometry & Position ────────────────────────────────
    monitor = 0
    follow = mouse
    width = 320
    height = 180
    origin = top-right
    offset = 15x70
    notification_limit = 4

    # ── Appearance ─────────────────────────────────────────
    transparency = 0
    corner_radius = 14
    frame_width = 1
    frame_color = "#C9A84C88"
    separator_height = 1
    separator_color = "#C9A84C33"

    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14

    gap_size = 6

    # ── Text ───────────────────────────────────────────────
    font = JetBrains Mono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n<span size='small' foreground='#999999'>%b</span>"
    alignment = left
    vertical_alignment = center
    word_wrap = true
    ellipsize = end
    show_age_threshold = 30

    # ── Icons ──────────────────────────────────────────────
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    icon_theme = "Adwaita, hicolor"

    # ── Interaction ────────────────────────────────────────
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    sticky_history = false
    show_indicators = false

    # ── Progress Bar ───────────────────────────────────────
    progress_bar = true
    progress_bar_height = 3
    progress_bar_frame_width = 0
    progress_bar_min_width = 280
    progress_bar_max_width = 320
    progress_bar_corner_radius = 1
    highlight = "#C9A84C"

    # ── Misc ───────────────────────────────────────────────
    sort = true
    idle_threshold = 60
    indicate_hidden = true
    hide_duplicate_count = false

# ═══════════════════════════════════════════════════════════
#  Urgency Levels — Amber Glass Palette
# ═══════════════════════════════════════════════════════════

[urgency_low]
    background = "#1A1408"
    foreground = "#BBBBBB"
    frame_color = "#C9A84C44"
    timeout = 4
    default_icon = dialog-information

[urgency_normal]
    background = "#1A1408"
    foreground = "#EAEAEA"
    frame_color = "#C9A84C88"
    timeout = 6
    default_icon = dialog-information

[urgency_critical]
    background = "#1A1408"
    foreground = "#FFFFFF"
    frame_color = "#E8A317"
    timeout = 0
    default_icon = dialog-warning

# ═══════════════════════════════════════════════════════════
#  App-Specific Rules
# ═══════════════════════════════════════════════════════════

# Volume / Brightness indicators
[volume]
    appname = "changevolume"
    timeout = 2
    set_transient = true
    history_ignore = true

[brightness]
    appname = "changebrightness"
    timeout = 2
    set_transient = true
    history_ignore = true

# Spotify / Music
[spotify]
    appname = "Spotify"
    frame_color = "#C9A84C"
    timeout = 4
    format = "<b>♫ %s</b>\n<span size='small' foreground='#C9A84C'>%b</span>"

# Screenshots
[screenshot]
    appname = "grim"
    timeout = 3
    format = "<b>  Captura guardada</b>\n<span size='small' foreground='#999999'>%b</span>"
